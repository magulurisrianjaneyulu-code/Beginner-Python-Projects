import random
board = [" "] * 9
def print_board():
    print()
    print(board[0], "|", board[1], "|", board[2])
    print("--+---+--")
    print(board[3], "|", board[4], "|", board[5])
    print("--+---+--")
    print(board[6], "|", board[7], "|", board[8])
    print()
def winner(player):
    wins = [
        (0, 1, 2), (3, 4, 5),
        (6, 7, 8), (0, 3, 6),
        (1, 4, 7), (2, 5, 8),
        (0, 4, 8), (2, 4, 6)
    ]
    return any(board[a] == board[b] == board[c] == player
               for a, b, c in wins)
for turn in range(9):
    print_board()
    # User
    position = int(input("Choose position 1-9: ")) - 1
    if position not in range(9) or board[position] != " ":
        print("Invalid position!")
        continue
    board[position] = "X"
    if winner("X"):
        print_board()
        print("You win!")
        break
    if " " not in board:
        print_board()
        print("Draw!")
        break
    # Computer
    available = [i for i in range(9) if board[i] == " "]
    computer_move = random.choice(available)
    board[computer_move] = "O"
    print("Computer chose:", computer_move + 1)
    if winner("O"):
        print_board()
        print("Computer wins!")
        break
